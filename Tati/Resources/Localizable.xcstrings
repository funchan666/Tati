          }
        }
      }
    },
    "Try a question about crispy food, plating, flavour balance, pasta, quick dinners, baking or vegetables." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag nach knusprigem Essen, Anrichten, Aromen, Pasta, schnellen Abendessen, Backen oder Gemüse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a question about crispy food, plating, flavour balance, pasta, quick dinners, baking or vegetables."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba una pregunta sobre comida crujiente, emplatado, sabores, pasta, cenas rápidas, repostería o verduras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez une question sur le croustillant, le dressage, les saveurs, les pâtes, un dîner rapide, la pâtisserie ou les légumes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サクサクの食感、盛り付け、味付け、パスタ、時短の夕食、お菓子作り、野菜について聞いてみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以问问酥脆口感、摆盘、调味、意面、快手晚餐、烘焙或蔬菜做法。"
          }
        }
      }
    },
    "Try a quick bowl: rice or noodles, a protein you enjoy, and two vegetables. Use lemon, olive oil and herbs for a simple dressing. Start with whatever is already in your kitchen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probiere eine schnelle Bowl: Reis oder Nudeln, eine Proteinquelle deiner Wahl und zwei Gemüsesorten. Zitronensaft, Olivenöl und Kräuter ergeben ein einfaches Dressing. Nimm zunächst die Zutaten, die du schon in der Küche hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a quick bowl: rice or noodles, a protein you enjoy, and two vegetables. Use lemon, olive oil and herbs for a simple dressing. Start with whatever is already in your kitchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba un bol rápido: arroz o fideos, una proteína que te guste y dos verduras. Aliña con limón, aceite de oliva y hierbas. Empieza con lo que ya tengas en la cocina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez un bol rapide : riz ou nouilles, une protéine que vous aimez et deux légumes. Faites une sauce simple avec du citron, de l’huile d’olive et des herbes. Commencez avec ce que vous avez déjà en cuisine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご飯や麺に、好きなたんぱく質の食材と野菜二種類を合わせたボウルはいかがでしょう。レモン、オリーブオイル、ハーブで手軽なソースになります。まずは家にある食材を組み合わせてみましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以试试快手碗餐：米饭或面条，加一份喜欢的蛋白质食材，再配两种蔬菜。用柠檬、橄榄油和香草调一份简单酱汁就很好吃。先用厨房里现有的食材组合就好。"
          }
        }
      }
    },
    "Try a shorter phrase, or save a feedback draft below." : {
