        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prix indicatifs en USD. La fiche d’achat Apple indique votre devise et le prix final."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
