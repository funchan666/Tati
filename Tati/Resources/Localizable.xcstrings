    "Recipes, markets, cooking questions and the meals you have tried belong here. Keep personal information and payment requests out of public posts." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile Rezepte, Marktbesuche, Kochfragen und ausprobierte Gerichte. Keine persönlichen Daten oder Zahlungsaufforderungen in öffentlichen Beiträgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recipes, markets, cooking questions and the meals you have tried belong here. Keep personal information and payment requests out of public posts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte recetas, mercados, dudas de cocina y platos que has probado. No publiques datos personales ni solicitudes de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez recettes, marchés, questions et plats essayés. Ne publiez ni données personnelles ni demandes de paiement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシピ、市場の話、料理の質問、試した食事を共有しましょう。公開投稿に個人情報や支払い要求を載せないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎分享食谱、市场见闻、烹饪问题和试过的菜。请勿在公开内容中透露隐私或提出付款要求。"
          }
        }
      }
    },
    "Reference prices in USD. Apple's purchase sheet shows your currency and final price." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referenzpreise in USD. Das Apple-Kauffenster zeigt deine Währung und den Endpreis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
