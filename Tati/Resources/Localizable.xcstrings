    "Coins are used only for room effects and profile frames." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Münzen werden nur für Raumeffekte und Profilrahmen verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins are used only for room effects and profile frames."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las monedas solo se usan para efectos de sala y marcos de perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces servent uniquement aux effets de salon et aux cadres de profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コインはルームエフェクトとプロフィールフレームにのみ使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金币仅用于房间特效和个人头像框。"
          }
        }
      }
    },
    "Coins unlock recipe chapters, room effects and profile frames. Free recipes, shopping lists, tasting notes and safety tools do not require coins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Münzen schalten Rezeptkapitel, Raumeffekte und Profilrahmen frei. Kostenlose Rezepte, Einkaufslisten, Notizen und Sicherheit benötigen keine Münzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins unlock recipe chapters, room effects and profile frames. Free recipes, shopping lists, tasting notes and safety tools do not require coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las monedas desbloquean capítulos, efectos de sala y marcos. Las recetas gratuitas, listas, notas y herramientas de seguridad no requieren monedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces débloquent des chapitres, effets et cadres. Les recettes gratuites, courses, notes et outils de sécurité n’en nécessitent pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コインでレシピ章、ルーム演出、プロフィールフレームを解放できます。無料レシピ、買い物リスト、試作メモ、安全機能にコインは不要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金币用于解锁主题食谱册、房间特效和资料头像框。免费食谱、采购清单、试做记录及安全工具均无需金币。"
          }
        }
      }
    },
