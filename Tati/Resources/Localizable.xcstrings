    "Your question is saved. Reopen Tati to finish the reply." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Frage ist gespeichert. Öffne Tati erneut, um die Antwort zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your question is saved. Reopen Tati to finish the reply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pregunta está guardada. Vuelve a abrir Tati para completar la respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre question est enregistrée. Rouvrez Tati pour terminer la réponse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問は保存されました。Tatiを開き直すと回答を再開できます。"
          }
        },
        "zh-Hans" : {
