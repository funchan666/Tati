    "Allow notifications in iPhone Settings, then return to Tati to enable your daily reminder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications in iPhone Settings, then return to Tati to enable your daily reminder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 设置中允许通知，再返回 Tati 开启每日提醒。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones en Ajustes del iPhone y vuelve a Tati para activar el recordatorio diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications dans les réglages de l’iPhone, puis revenez dans Tati pour activer le rappel quotidien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen in den iPhone-Einstellungen und kehre zu Tati zurück, um die tägliche Erinnerung einzuschalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの設定で通知を許可してから、Tatiに戻って毎日のリマインダーを有効にしてください。"
          }
        }
      }
    },
