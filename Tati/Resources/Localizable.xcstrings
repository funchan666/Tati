        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁止色情、剥削、威胁、仇恨或骚扰内容。不得通过 Tati 安排性服务或针对他人实施伤害。"
          }
        }
      }
