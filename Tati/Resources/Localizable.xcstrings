    "Their posts, comments, rooms and conversations will be hidden. You can unblock them in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their posts, comments, rooms and conversations will be hidden. You can unblock them in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其动态、评论、房间和聊天将被隐藏，可在设置中解除拉黑。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus publicaciones, comentarios, salas y conversaciones se ocultarán. Puedes desbloquear este perfil en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses publications, commentaires, salons et conversations seront masqués. Vous pourrez le débloquer dans les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge, Kommentare, Räume und Unterhaltungen werden ausgeblendet. Du kannst das Profil in den Einstellungen entsperren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿、コメント、ルーム、会話が非表示になります。設定でブロックを解除できます。"
          }
        }
      }
    },
