    "Your changes could not be verified. Saving is paused to protect your data. Check available storage, then reopen Tati.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes could not be verified. Saving is paused to protect your data. Check available storage, then reopen Tati."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认更改已保存。为保护数据，已暂停保存。请检查可用存储空间后重新打开 Tati。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron verificar los cambios. El guardado está en pausa para proteger tus datos. Comprueba el espacio disponible y vuelve a abrir Tati."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements n’ont pas pu être vérifiés. L’enregistrement est suspendu pour protéger vos données. Vérifiez l’espace disponible, puis rouvrez Tati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderungen konnten nicht überprüft werden. Zum Schutz deiner Daten ist das Speichern pausiert. Prüfe den freien Speicher und öffne Tati erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更の保存を確認できないため、データ保護のため保存を一時停止しています。空き容量を確認してTatiを開き直してください。"
          }
        }
      }
    },
    "Your saved data could not be opened. It has not been replaced. Please check available storage before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved data could not be opened. It has not been replaced. Please check available storage before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开已保存的数据，原数据未被覆盖。请检查可用存储空间后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron abrir tus datos guardados y no se han reemplazado. Comprueba el espacio disponible antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données enregistrées n’ont pas pu être ouvertes. Elles n’ont pas été remplacées. Vérifiez l’espace disponible avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Daten konnten nicht geöffnet werden und wurden nicht ersetzt. Prüfe den freien Speicher, bevor du es erneut versuchst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みデータを開けませんでした。データは置き換えられていません。空き容量を確認してから再試行してください。"
          }
        }
      }
    },
