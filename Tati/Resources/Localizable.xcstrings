    "Drop by Tati for food, friends and your daily check-in." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau bei Tati vorbei: Essen, Freunde und dein täglicher Check-in warten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop by Tati for food, friends and your daily check-in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pásate por Tati para disfrutar de comida, amigos y tu registro diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez sur Tati pour la cuisine, les amis et votre pointage quotidien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatiで料理や友だちとの時間を楽しもう。毎日のチェックインも忘れずに。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来 Tati 看美食、遇朋友，别忘了每日签到。"
          }
        }
      }
    },
    "Dry vegetables well, cut them into similar sizes and give them space on the tray. Roast until the edges colour, turning as needed. Finish with lemon and herbs for a brighter flavour." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trockne das Gemüse gut, schneide es in ähnlich große Stücke und lasse Platz auf dem Blech. Röste es, bis die Ränder Farbe bekommen, und wende es bei Bedarf. Zitrone und Kräuter sorgen zum Schluss für Frische."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dry vegetables well, cut them into similar sizes and give them space on the tray. Roast until the edges colour, turning as needed. Finish with lemon and herbs for a brighter flavour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seca bien las verduras, córtalas de tamaño parecido y deja espacio en la bandeja. Ásalas hasta que se doren los bordes, girándolas cuando haga falta. Termina con limón y hierbas para dar frescura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séchez bien les légumes, coupez-les à taille égale et espacez-les sur la plaque. Rôtissez jusqu’à coloration des bords en les retournant si nécessaire. Terminez avec du citron et des herbes pour plus de fraîcheur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "野菜の水分をよく拭き、大きさをそろえて切り、天板に間隔を空けて並べます。必要に応じて返しながら、縁に焼き色がつくまで焼きましょう。仕上げにレモンとハーブを添えると爽やかです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把蔬菜表面擦干，切成差不多的大小，放烤盘时留些间距。烤到边缘上色，中途按需翻面。出炉后加一点柠檬和香草，味道会更清爽。"
          }
        }
      }
    },
