    "Open My wallet from your profile for coin packs and Apple prices. Daily check-ins also add reward coins." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Mein Wallet in deinem Profil für Münzpakete und Apple-Preise. Beim täglichen Check-in gibt es außerdem Bonusmünzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open My wallet from your profile for coin packs and Apple prices. Daily check-ins also add reward coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Mi cartera desde tu perfil para ver los paquetes y precios de Apple. También puedes obtener monedas de recompensa al registrarte cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Mon portefeuille depuis votre profil pour voir les packs et les prix Apple. Le pointage quotidien ajoute aussi des pièces de récompense."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールの「ウォレット」でコインパックとAppleの価格を確認できます。毎日のチェックインでも報酬コインを受け取れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从个人页进入「我的钱包」，查看金币套餐和 Apple 价格。每日签到也能领取奖励金币。"
          }
        }
      }
    },
    "Open Settings" : {
