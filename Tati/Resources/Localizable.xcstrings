    "No sexual content, exploitation, threats, hate or harassment. Do not use Tati to arrange sexual services or target other people." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine sexuellen Inhalte, Ausbeutung, Drohungen, Hass oder Belästigung. Nutze Tati nicht für sexuelle Dienstleistungen oder Angriffe auf andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No sexual content, exploitation, threats, hate or harassment. Do not use Tati to arrange sexual services or target other people."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se permite contenido sexual, explotación, amenazas, odio ni acoso. No uses Tati para ofrecer servicios sexuales o atacar a otras personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun contenu sexuel, exploitation, menace, haine ou harcèlement. N’utilisez pas Tati pour organiser des services sexuels ni cibler d’autres personnes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "性的内容、搾取、脅迫、ヘイト、嫌がらせは禁止です。性的サービスの手配や他人への攻撃にTatiを使わないでください。"
