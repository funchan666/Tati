    "Voice call checks microphone permission. Video call shows your camera. Neither connects to another person yet. The camera stops when you close the screen or leave Tati." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sprachanruf prüft die Mikrofonfreigabe, der Videoanruf zeigt dein Kamerabild. Beide verbinden noch keine andere Person. Beim Schließen oder Verlassen von Tati stoppt die Kamera."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice call checks microphone permission. Video call shows your camera. Neither connects to another person yet. The camera stops when you close the screen or leave Tati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La llamada de voz comprueba el permiso del micrófono y la de vídeo muestra tu cámara. Aún no conectan con otra persona. La cámara se detiene al cerrar la pantalla o salir de Tati."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appel vocal vérifie l’autorisation du microphone. L’appel vidéo montre votre caméra. Aucun ne connecte encore une autre personne. La caméra s’arrête quand vous fermez l’écran ou quittez Tati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声通話画面ではマイクの許可、ビデオ通話画面ではカメラ映像を確認できます。まだ相手には接続されません。画面を閉じるかTatiを離れるとカメラは停止します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音通话页可以检查麦克风权限，视频通话页可以查看摄像头画面。目前都不会连接其他人。关闭页面或切出 Tati 后，摄像头会停止。"
          }
        }
      }
    },
    "Voice calls are unavailable and do not request microphone access. The video screen can show your camera after you tap Enable camera. It does not connect to another person." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachanrufe sind nicht verfügbar und fragen keinen Mikrofonzugriff an. Nach Kameraaktivierung zeigt die Videoseite dein Kamerabild, ohne Verbindung zu einer anderen Person."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice calls are unavailable and do not request microphone access. The video screen can show your camera after you tap Enable camera. It does not connect to another person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas de voz no están disponibles ni solicitan el micrófono. La pantalla de vídeo muestra tu cámara al activarla, sin conectar con otra persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels vocaux sont indisponibles et ne demandent pas le micro. L’écran vidéo montre votre caméra après activation, sans connexion à une autre personne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声通話は利用できず、マイク権限も求めません。ビデオ画面はカメラ有効化後に映像を表示できますが、他人とは接続しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音通话暂不可用，不会申请麦克风权限。点击启用相机后，视频页面可显示相机画面，但不会连接他人。"
          }
        }
      }
    },
    "Voice calls are unavailable. Checking microphone access does not start a call or a recording." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachanrufe sind nicht verfügbar. Die Prüfung der Mikrofonfreigabe startet weder einen Anruf noch eine Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice calls are unavailable. Checking microphone access does not start a call or a recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas de voz no están disponibles. Comprobar el acceso al micrófono no inicia una llamada ni una grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels vocaux sont indisponibles. Vérifier l’accès au microphone ne lance ni appel ni enregistrement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、音声通話は利用できません。マイクの許可を確認しても、通話や録音は開始されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法进行语音通话。检查麦克风权限不会发起通话或录音。"
          }
        }
      }
    },
