    "Daily reminders?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily reminders?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启每日提醒？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Activar recordatorios diarios?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les rappels quotidiens ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Erinnerungen aktivieren?"
          }
        },
