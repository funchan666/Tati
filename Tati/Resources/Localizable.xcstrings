    "Check ingredient labels for your allergies. Do not post unsafe food challenges or medical and weight-loss promises." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe Zutatenetiketten auf deine Allergien. Keine gefährlichen Essens-Challenges oder medizinischen und Abnehmversprechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check ingredient labels for your allergies. Do not post unsafe food challenges or medical and weight-loss promises."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa las etiquetas según tus alergias. No publiques retos alimentarios peligrosos ni promesas médicas o de pérdida de peso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les étiquettes selon vos allergies. Aucun défi alimentaire dangereux ni promesse médicale ou minceur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アレルギーに合わせて原材料表示を確認してください。危険な食の挑戦や、医療・減量効果の保証を投稿しないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请根据自己的过敏情况检查食材标签。不要发布危险饮食挑战、医疗或减重效果承诺。"
          }
        }
      }
    },
    "Check your connection and try again." : {
