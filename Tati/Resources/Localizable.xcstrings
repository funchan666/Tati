    "Bonus coins are used first. Room effects play on your screen and do not transfer coins to another user." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonusmünzen werden zuerst verwendet. Raumeffekte erscheinen nur auf deinem Bildschirm und übertragen keine Münzen an andere Personen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonus coins are used first. Room effects play on your screen and do not transfer coins to another user."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se usan las monedas de recompensa. Los efectos solo aparecen en tu pantalla y no transfieren monedas a otra persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces bonus sont utilisées en premier. Les effets apparaissent uniquement sur votre écran et ne transfèrent aucune pièce à une autre personne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボーナスコインから先に使用します。エフェクトは自分の画面にのみ表示され、他のユーザーにコインを送るものではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先使用奖励金币。房间特效只作用于你的画面，不会向其他用户转赠金币。"
          }
        }
      }
    },
