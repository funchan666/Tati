    "Drop by Tati for food, friends and your daily check-in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop by Tati for food, friends and your daily check-in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来 Tati 看美食、遇朋友，别忘了每日签到。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pásate por Tati para disfrutar de comida, amigos y tu registro diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez sur Tati pour la cuisine, les amis et votre pointage quotidien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau bei Tati vorbei: Essen, Freunde und dein täglicher Check-in warten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatiで料理や友だちとの時間を楽しもう。毎日のチェックインも忘れずに。"
          }
        }
      }
    },
