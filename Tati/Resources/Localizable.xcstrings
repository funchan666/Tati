    },
    "Your profile holds your videos, rewards and room-effect history. Logging out keeps them. Deleting your profile removes its records and imported files from Tati." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profil enthält Videos, Belohnungen und Raum-Effekte. Beim Abmelden bleiben sie erhalten. Beim Löschen des Profils werden seine Daten und importierten Dateien aus Tati entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile holds your videos, rewards and room-effect history. Logging out keeps them. Deleting your profile removes its records and imported files from Tati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu perfil están tus vídeos, recompensas e historial de efectos. Cerrar sesión los conserva. Eliminar el perfil borra de Tati sus registros y archivos importados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil regroupe vidéos, récompenses et historique des effets. La déconnexion les conserve. Supprimer le profil efface ses données et fichiers importés de Tati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールで動画、報酬、ルームエフェクトの履歴を確認できます。ログアウトしても残りますが、プロフィールを削除すると関連データと読み込んだファイルがTatiから削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "个人页可查看视频、奖励和房间特效记录。退出登录不会删除它们；删除资料会从 Tati 移除相关记录和导入的文件。"
          }
        }
      }
    },
