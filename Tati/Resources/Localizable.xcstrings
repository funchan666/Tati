    "Camera access is off. You can choose a photo from your library, or review access in Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff ist aus. Wähle ein Foto oder prüfe den Zugriff in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is off. You can choose a photo from your library, or review access in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara está desactivada. Puedes elegir una foto o revisar el acceso en Ajustes."
