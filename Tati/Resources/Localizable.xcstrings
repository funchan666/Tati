    "Your changes could not be verified. Saving is paused to protect your data. Check available storage, then reopen Tati." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderungen konnten nicht überprüft werden. Zum Schutz deiner Daten ist das Speichern pausiert. Prüfe den freien Speicher und öffne Tati erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your changes could not be verified. Saving is paused to protect your data. Check available storage, then reopen Tati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron verificar los cambios. El guardado está en pausa para proteger tus datos. Comprueba el espacio disponible y vuelve a abrir Tati."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les changements n’ont pas pu être vérifiés. L’enregistrement est suspendu pour protéger vos données. Vérifiez l’espace disponible, puis rouvrez Tati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更の保存を確認できないため、データ保護のため保存を一時停止しています。空き容量を確認してTatiを開き直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认更改已保存。为保护数据，已暂停保存。请检查可用存储空间后重新打开 Tati。"
          }
        }
      }
    },
