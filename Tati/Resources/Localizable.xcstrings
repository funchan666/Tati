          }
        }
      }
    },
    "Get a daily check-in reminder at 19:00, using your device's local time. You can turn it off here at any time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a daily check-in reminder at 19:00, using your device's local time. You can turn it off here at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天按设备当地时间 19:00 提醒签到，可随时在此关闭。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un recordatorio diario a las 19:00, según la hora local del dispositivo. Puedes desactivarlo aquí cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez un rappel quotidien à 19 h, selon l’heure locale de votre appareil. Vous pouvez le désactiver ici à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte täglich um 19:00 Uhr Ortszeit deines Geräts eine Erinnerung. Du kannst sie hier jederzeit ausschalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の現地時間で毎日19時にチェックインをお知らせします。ここでいつでもオフにできます。"
          }
        }
      }
    },
