    "Check-in resets at midnight UTC. Reward coins cannot be exchanged for money." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Check-in wird um Mitternacht UTC zurückgesetzt. Bonusmünzen lassen sich nicht in Geld umtauschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in resets at midnight UTC. Reward coins cannot be exchanged for money."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro se reinicia a medianoche UTC. Las monedas de recompensa no se pueden cambiar por dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pointage se réinitialise à minuit UTC. Les pièces de récompense ne sont pas échangeables contre de l’argent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックインは毎日UTC午前0時にリセットされます。報酬コインは換金できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签到于 UTC 每日零点重置，奖励金币不可兑换现金。"
          }
        }
      }
    },
    "Choose a cover, add a title and preview your camera" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Titelbild, ergänze einen Titel und prüfe die Kameravorschau"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a cover, add a title and preview your camera"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una portada, añade un título y previsualiza la cámara"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une couverture, ajoutez un titre et prévisualisez la caméra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カバーとタイトルを設定し、カメラをプレビューします"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择封面、填写标题并预览摄像头"
          }
        }
      }
    },
    "Choose a plate that leaves a little space around the food. Build a small amount of height, add one contrasting colour, and wipe the rim. Soft light from a window makes a lovely finishing touch." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Teller, auf dem rund um das Essen etwas Platz bleibt. Richte leicht in die Höhe an, ergänze eine Kontrastfarbe und wische den Rand sauber. Weiches Fensterlicht setzt das Gericht schön in Szene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a plate that leaves a little space around the food. Build a small amount of height, add one contrasting colour, and wipe the rim. Soft light from a window makes a lovely finishing touch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un plato que deje algo de espacio alrededor de la comida. Da un poco de altura, añade un color de contraste y limpia el borde. La luz suave de una ventana da un bonito toque final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une assiette qui laisse un peu d’espace autour du plat. Donnez un peu de hauteur, ajoutez une couleur contrastante et essuyez le bord. Une douce lumière de fenêtre apporte une belle touche finale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "料理の周りに少し余白ができるお皿を選びます。少し高さを出して盛り、差し色を一つ添え、お皿の縁をきれいに拭きましょう。窓辺の柔らかな光で撮ると、よりおいしそうに見えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选一个能让食物四周留点空白的盘子。盛盘时稍微叠出高度，再加入一种对比色，最后擦净盘边。拍照时用窗边柔和的自然光，会更显食欲。"
          }
        }
      }
    },
    "Choose a reason to continue." : {
      "extractionState" : "manual",
      "localizations" : {
