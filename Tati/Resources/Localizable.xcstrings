    "Open Settings, then Language. Choose English, Chinese, Spanish, French, German or Japanese. Your choice updates the interface immediately and is saved for your next visit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Einstellungen und dann Sprache. Wähle Englisch, Chinesisch, Spanisch, Französisch, Deutsch oder Japanisch. Die Oberfläche wird sofort aktualisiert und deine Auswahl bleibt gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings, then Language. Choose English, Chinese, Spanish, French, German or Japanese. Your choice updates the interface immediately and is saved for your next visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes y luego Idioma. Elige inglés, chino, español, francés, alemán o japonés. La interfaz se actualiza al instante y tu elección se guarda para la próxima visita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Réglages, puis Langue. Choisissez l’anglais, le chinois, l’espagnol, le français, l’allemand ou le japonais. L’interface se met à jour immédiatement et votre choix est conservé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定の「言語」で英語、中国語、スペイン語、フランス語、ドイツ語、日本語を選択できます。すぐに画面へ反映され、次回も保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开设置中的语言，可选择英语、中文、西班牙语、法语、德语或日语。更改立即应用到界面，下次打开时也会保留。"
          }
        }
      }
    },
