    "Changes apply immediately and are saved for your next visit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply immediately and are saved for your next visit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改立即生效，下次打开时会保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican al instante y se guardan para tu próxima visita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements s’appliquent immédiatement et sont conservés pour votre prochaine visite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten sofort und bleiben beim nächsten Besuch erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はすぐに反映され、次回も保持されます。"
          }
        }
      }
    },
