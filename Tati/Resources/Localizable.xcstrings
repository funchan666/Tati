    "The options on profiles, videos, comments and rooms let you report content or block its author. Blocking hides their content and conversations. You can manage blocked profiles in Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Profilen, Videos, Kommentaren und Räumen kannst du Inhalte melden oder Autoren blockieren. Blockieren blendet Inhalte und Gespräche aus. Verwalte blockierte Profile in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The options on profiles, videos, comments and rooms let you report content or block its author. Blocking hides their content and conversations. You can manage blocked profiles in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las opciones de perfiles, vídeos, comentarios y salas permiten denunciar o bloquear al autor. El bloqueo oculta su contenido y conversaciones. Administra los bloqueos en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les options des profils, vidéos, commentaires et salons permettent de signaler ou bloquer l’auteur. Le blocage masque son contenu et ses conversations. Gérez les profils bloqués dans les réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール、動画、コメント、ルームのメニューから報告や投稿者のブロックができます。ブロックすると相手の内容と会話が非表示になります。設定で管理できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "资料、视频、评论和房间的选项中可举报内容或拉黑作者。拉黑会隐藏其内容和对话，你可在设置中管理黑名单。"
          }
        }
      }
    },
    "The permission request could not finish. Please try again." : {
