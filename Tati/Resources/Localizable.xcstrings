    "Only use photos, videos and recipes you have permission to share. Do not claim another person's work as your own." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile nur Fotos, Videos und Rezepte, für die du eine Erlaubnis hast. Gib fremde Arbeit nicht als deine eigene aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only use photos, videos and recipes you have permission to share. Do not claim another person's work as your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa solo fotos, vídeos y recetas que tengas permiso para compartir. No presentes trabajo ajeno como propio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne partagez que des photos, vidéos et recettes autorisées. Ne présentez pas le travail d’autrui comme le vôtre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有する権利のある写真、動画、レシピだけを使い、他人の作品を自分のものとして扱わないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只分享你有权使用的照片、视频和食谱，不要冒用他人的作品。"
          }
        }
      }
    },
