    "This permanently removes your Tati profile, imported photos and videos, drafts and coin balance from app storage. Consumable coins cannot be restored after deletion." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tati-Profil, importierte Fotos und Videos, Entwürfe und Münzguthaben werden dauerhaft aus dem App-Speicher gelöscht. Verbrauchbare Münzen können danach nicht wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently removes your Tati profile, imported photos and videos, drafts and coin balance from app storage. Consumable coins cannot be restored after deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de forma permanente tu perfil de Tati, las fotos y vídeos importados, los borradores y el saldo de monedas del almacenamiento de la app. Las monedas consumibles no se pueden recuperar tras la eliminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil Tati, vos photos et vidéos importées, vos brouillons et votre solde de pièces seront définitivement supprimés du stockage de l’app. Les pièces consommables ne pourront pas être restaurées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ内のTatiプロフィール、読み込んだ写真と動画、下書き、コイン残高を完全に削除します。消耗型コインは削除後に復元できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会永久删除应用内的 Tati 资料、导入的照片和视频、草稿及金币余额。消耗型金币在删除后无法恢复。"
          }
        }
      }
